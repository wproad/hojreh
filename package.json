{
  "name": "hojreh",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tailwindcss -i ./theme/hojreh/src/css/app.css -o ./theme/hojreh/assets/dist/app.css --watch",
    "build:css": "tailwindcss -i ./theme/hojreh/src/css/app.css -o ./theme/hojreh/assets/dist/app.css --minify",
    "build:js": "cp ./theme/hojreh/src/js/app.js ./theme/hojreh/assets/dist/app.js",
    "build": "pnpm build:css && pnpm build:js",
    "test:ui": "node scripts/test-ui.mjs",
    "test:shots": "node scripts/test-shots.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4",
    "playwright": "^1.64.1",
    "tailwindcss": "4"
  }
}
